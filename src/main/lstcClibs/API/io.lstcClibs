Warning: highly advised to evade the source code cuz this shit is hard to read asf
!-!-!-!-!-!-!-!-!-!-!-!-!-!-!-!-!-!-!-!-!-!-!
All functions have prefix LSTC_
 - internal helper function : printEXP ( const char* o, int fd, L__U64 sz )
 basically LSTC_write but with loop integrated into it (or LSTC_print but with sz parameter)

asm functions

 extern L__S64 LSTC_write(int fd, const char* buf, L__U64 ctn);
 extern L__S64 LSTC_read(int fd, char* buf, L__U64 ctn);
 extern L__S64 LSTC_open(int dirfd, const char* name, int flags, LSTC_LinuxUMode_t mode) ;
 extern L__S64 LSTC_close(int fd);
 extern L__S64 LSTC_lseek(int fd, L__S64 offset, L__U32 whence);
  - can be SEEK_SET (begining), SEEK_CUR (where you are) or SEEK_END (EOF)
 extern L__S64 LSTC_create(const char* name, LSTC_LinuxUMode_t mode);
(*)LSTC_LinuxUMode_t is a unsigned short int
 - R : read | W : write | E : execute
 - can be:
 LSTC_OPEN_MODE_RWE_R (0755) | RWE for owner, RE for group, R for others
 LSTC_OPEN_MODE_RW_X  (0600) | RW for owner, none for others
 LSTC_OPEN_MODE_RW_R  (0644) | RW for owner, R for group and others

static L__BOOL LSTC_print(const char* o, int fd)

prints `o` to `fd` (with the loop)

static inline LSTC_IO_BUFFER_Ctx LSTC_create_ctx(int fd, L__U64 sz)
 - automatically allocates and sets up context
static inline void LSTC_flushctx(LSTC_IO_BUFFER_Ctx* ctx)
 - helper to flush context
